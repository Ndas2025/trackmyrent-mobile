{
  "name": "trackmyrent-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android": "expo export --platform android --output-dir ../output/android-export",
    "export:ios": "expo export --platform ios --output-dir ../output/ios-export",
    "build:android": "pnpm dlx eas-cli build --platform android --profile production",
    "build:ios": "pnpm dlx eas-cli build --platform ios --profile production",
    "build:all": "pnpm dlx eas-cli build --platform all --profile production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~57.0.2",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  }
}
